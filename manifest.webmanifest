{
  "name": "Campos Kosten",
  "short_name": "Campos",
  "description": "Kosten für das Haus in Campos schnell erfassen – per Foto, PDF oder E-Mail.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f5",
  "theme_color": "#0f766e",
  "lang": "de",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", "message/rfc822", ".eml", "text/plain"] }
      ]
    }
  }
}
